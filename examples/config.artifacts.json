{
  "run_dir": "../runs/offline",
  "target": {
    "base_url": "http://localhost/app/",
    "source_root": "../sample-app",
    "language": "php"
  },
  "database": {"driver": "none"},
  "crawl": {
    "mode": "artifacts",
    "roles": [
      {"name": "admin", "kind": "admin", "artifact": "crawl/admin.json"},
      {"name": "user1", "kind": "user", "artifact": "crawl/user1.json"},
      {"name": "visitor", "kind": "visitor", "artifact": "crawl/visitor.json"}
    ]
  },
  "analysis": {
    "active_detection": false,
    "identity_parameters": ["id", "user_id"]
  },
  "repair": {"enabled": false}
}

