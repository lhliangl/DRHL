{
    "run_dir":  "../runs/phpns",
    "target":  {
                   "base_url":  "http://localhost/phpns/",
                   "source_root":  "D:/phpStudy/PHPTutorial/WWW/phpns",
                   "language":  "php",
                   "public_extensions":  [
                                             ".php"
                                         ]
               },
    "database":  {
                     "driver":  "mysql",
                     "host":  "127.0.0.1",
                     "port":  3306,
                     "database":  "phpns",
                     "user":  "root",
                     "password":  "env:DRHL_DB_PASSWORD"
                 },
    "crawl":  {
                  "mode":  "selenium",
                  "root_url":  "http://localhost/phpns/",
                  "scope_path":  "/phpns/",
                  "strategy":  "dfs",
                  "headless":  true,
                  "max_pages":  300,
                  "delay":  0.2,
                  "preserve_query_parameters":  [
                                                    "action",
                                                    "do",
                                                    "mode"
                                                ],
                  "exclude_url_markers":  [
                                              "logout",
                                              "logoff"
                                          ],
                  "secret_parameters":  [
                                            "password",
                                            "passwd",
                                            "pwd",
                                            "token",
                                            "csrf",
                                            "_token"
                                        ],
                  "skip_source_dirs":  [
                                           "vendor",
                                           "node_modules"
                                       ],
                  "roles":  [
                                {
                                    "name":  "admin",
                                    "kind":  "admin",
                                    "crawl_login":  {
                                                        "url":  "login.php",
                                                        "fields":  {
                                                                       "input[name=\u0027username\u0027]":  "admin",
                                                                       "input[name=\u0027password\u0027]":  "env:DRHL_ADMIN_PASSWORD"
                                                                   },
                                                        "submit":  "form input[type=\u0027submit\u0027]"
                                                    },
                                    "http_login":  {
                                                       "url":  "login.php?do=p",
                                                       "method":  "POST",
                                                       "data":  {
                                                                    "username":  "admin",
                                                                    "password":  "env:DRHL_ADMIN_PASSWORD"
                                                                }
                                                   }
                                },
                                {
                                    "name":  "user1",
                                    "kind":  "user",
                                    "crawl_login":  {
                                                        "url":  "login.php",
                                                        "fields":  {
                                                                       "input[name=\u0027username\u0027]":  "user1",
                                                                       "input[name=\u0027password\u0027]":  "env:DRHL_USER1_PASSWORD"
                                                                   },
                                                        "submit":  "form input[type=\u0027submit\u0027]"
                                                    },
                                    "http_login":  {
                                                       "url":  "login.php?do=p",
                                                       "method":  "POST",
                                                       "data":  {
                                                                    "username":  "user1",
                                                                    "password":  "env:DRHL_USER1_PASSWORD"
                                                                }
                                                   }
                                },
                                {
                                    "name":  "visitor",
                                    "kind":  "visitor"
                                }
                            ]
              },
    "analysis":  {
                     "source_analysis":  {
                                             "save_cst":  false,
                                             "identity_parameters":  [
                                                                         "user_id",
                                                                         "userid"
                                                                     ],
                                             "access_control_database_fields":  [
                                                                                    "users.role",
                                                                                    "users.privilege",
                                                                                    "users.user_id",
                                                                                    "users.userid"
                                                                                ]
                                         },
                     "active_detection":  true,
                     "identity_parameters":  [
                                                 "id",
                                                 "user",
                                                 "user_id",
                                                 "userid"
                                             ],
                     "horizontal_overrides":  {
                                                  "id":  "2",
                                                  "user":  "user2",
                                                  "user_id":  "2",
                                                  "userid":  "2"
                                              },
                     "oracle":  {
                                    "timeout":  10,
                                    "denied_statuses":  [
                                                            401,
                                                            403
                                                        ],
                                    "login_url_markers":  [
                                                              "login",
                                                              "signin"
                                                          ],
                                    "deny_markers":  [
                                                         "access denied",
                                                         "permission denied",
                                                         "unauthorized",
                                                         "forbidden"
                                                     ]
                                }
                 },
    "repair":  {
                   "enabled":  true,
                   "output_dir":  "repair/files",
                   "llm":  {
                               "enabled":  false,
                               "provider":  "openai_compatible",
                               "base_url":  "https://api.deepseek.com/v1",
                               "model":  "deepseek-v4-flash",
                               "api_key":  "env:DEEPSEEK_API_KEY",
                               "temperature":  0.1,
                               "timeout":  120,
                               "response_format_json":  true,
                               "input_cost_per_million_tokens":  0,
                               "output_cost_per_million_tokens":  0
                           }
               }
}