  "analysis": {
    "source_analysis": {
      "save_cst": false,
      "identity_parameters": [],
      "access_control_database_fields": [
        "phpoll_test_configurazione.login",
        "phpoll_test_configurazione.password"
      ],
      "validated_function_name_patterns": [],
      "termination_patterns": [
        "\\$test_log\\s*=\\s*true\\s*;"
      ],
      "llm_snippet_exclude_code_patterns": [
        "^if\\s*\\(\\$log\\s*!=\\s*\"admin\"\\s*&&\\s*\\$pw\\s*!=\\s*\"admin\"\\s*\\)\\s*\\{\\s*\\$test_log\\s*=\\s*true\\s*;\\s*\\}$"
      ],
      "llm_snippet_prefix_rules": [
        {
          "path_pattern": "^admin/(?:band_editor|config_editor|votanti)\\.php$",
          "code_pattern": "\\$_COOKIE\\[\\$string_cook_login\\]",
          "prefix": "$query_login = \"SELECT login, password FROM phpoll_\".$prepoll.\"_configurazione;\";\n$estrai_login = mysql_query($query_login, $phpoll_db)\n  or die (\"Errore nella connessione per estrazione login configurazione dal database \".$phpoll_database);\n$dati_login = mysql_fetch_assoc($estrai_login);\n$string_cook_login = \"phpoll_\".$prepoll.\"_login\";\n$string_cook_password = \"phpoll_\".$prepoll.\"_password\";\n$log=$dati_login['login'];\n$pw=$dati_login['password'];\n$test_log = false;"
        }
      ],
      "validated_function_code_patterns": [
        "\\b(?:login|password|cookie|setcookie|phpoll_.*_(?:login|password)|test_log|REMOTE_ADDR)\\b",
        "\\$_COOKIE|\\$_SERVER\\[\\'REMOTE_ADDR\\'\\]"
      ]
    },
    "active_detection": true,
    "identity_parameters": [
      "id",
      "language",
      "nuova_band"
    ],
    "horizontal_overrides": {
      "id": "1"
    },
    "oracle": {
      "timeout": 10,
      "csrf_token_parameters": [],
      "denied_statuses": [
        401,
        403
      ],
      "login_url_markers": [
        "elabora_cookie.php"
      ],
      "deny_markers": [
        "login",
        "password",
        "try a different way",
        "errore"
      ],
      "extract_source_deny_markers": true,
      "confirm_get_read": true,
      "static_only_confirm_patterns": [
        "^admin/index\\.php$",
        "^admin/config_editor\\.php$",
        "^admin/band_editor\\.php$",
        "^admin/votanti\\.php$",
        "^admin/risultati_config\\.php$"
