  "repair": {
    "enabled": true,
    "output_dir": "repair/files",
    "llm": {
      "enabled": true,
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "api_key": "env:DRHL_DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "php_binary": "D:/phpStudy/PHPTutorial/php/php-5.2.17/php.exe",
      "syntax_timeout": 30,
      "temporary_apply_to_source": true,
      "database_oracles": {
        "database_primary_patterns": [
          "^admin/modifica_(?:band|configurazione|votanti)\\.php(?:\\?|$)"
        ],
        "rules": [
          {
            "name": "PHPOLL-band-update",
            "page_pattern": "^admin/modifica_band\\.php(?:\\?|$)",
            "category": "admin_only",
            "operation": "update",
            "variables": {
              "band_id": {
                "query": "SELECT COALESCE(MAX(id), 0) + 1 FROM phpoll_test_band"
              }
            },
            "setup_sql": [
              "INSERT INTO phpoll_test_band (id, nome_band, voti) VALUES ({band_id}, '{token1}', 0)"
            ],
            "attack": {
              "role": "visitor",
              "request": {
                "page": "admin/modifica_band.php?language=1&nuova_band=2",
                "method": "POST",
                "replace_params": true,
                "params": {
                  "nome_band_0": "{token2}",
                  "voti_0": "0",
                  "check_0": "off",
                  "id_0": "{band_id}"
                },
                "referer": "admin/band_editor.php?language=1"
              },
              "assert": {
                "query": "SELECT nome_band FROM phpoll_test_band WHERE id={band_id}",
                "scalar_equals": "{token1}"
              }
            },
            "authorized": {
              "role": "admin",
              "request": {
                "page": "admin/modifica_band.php?language=1&nuova_band=2",
                "method": "POST",
                "replace_params": true,
                "params": {
                  "nome_band_0": "{token2}",
                  "voti_0": "0",
                  "check_0": "off",
                  "id_0": "{band_id}"
                },
                "referer": "admin/band_editor.php?language=1"
              },
              "assert": {
                "query": "SELECT nome_band FROM phpoll_test_band WHERE id={band_id}",
                "scalar_equals": "{token2}"
              }
            }
          },
          {
