          {
            "name": "PHPOLL-vote-delete",
            "page_pattern": "^admin/modifica_votanti\\.php(?:\\?|$)",
            "category": "admin_only",
            "operation": "delete",
            "variables": {
              "band_id": {
                "query": "SELECT COALESCE(MAX(id), 0) + 1 FROM phpoll_test_band"
              },
              "vote_id": {
                "query": "SELECT COALESCE(MAX(id), 0) + 1 FROM phpoll_test_voti"
              }
            },
            "setup_sql": [
              "INSERT INTO phpoll_test_band (id, nome_band, voti) VALUES ({band_id}, '{token}', 1)",
              "INSERT INTO phpoll_test_voti (id, ip, band_votate, timestamp, votato, email, browser) VALUES ({vote_id}, '127.0.0.1', '{token}', 0, '1', '{token}@example.test', 'DRHL')"
            ],
            "attack": {
              "role": "visitor",
              "request": {
                "page": "admin/modifica_votanti.php?language=1",
                "method": "POST",
                "replace_params": true,
                "params": {
                  "{vote_id}": "on",
                  "checkall": "on"
                },
                "referer": "admin/votanti.php?language=1"
              },
              "assert": {
                "query": "SELECT COUNT(*) FROM phpoll_test_voti WHERE id={vote_id}",
