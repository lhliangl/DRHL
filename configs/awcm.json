        "sender",
        "reciever",
        "memid"
      ],
      "access_control_database_fields": [
        "awcm_members.id",
        "awcm_members.level",
        "awcm_online.memid",
        "awcm_member_pms.sender",
        "awcm_member_pms.reciever",
