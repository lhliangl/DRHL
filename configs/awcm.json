      "api_key": "env:DRHL_DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "php_binary": "D:/phpStudy/PHPTutorial/php/php-5.2.17/php.exe",
      "syntax_timeout": 30,
      "temporary_apply_to_source": true,
      "database_oracles": [
        {
          "name": "AWCM-GT-001-avatar-form-read",
          "page_pattern": "^m_cp_avatar\\.php\\?KeepThis(?:=|&|$)",
          "category": "authenticated_only",
          "operation": "read",
          "attack": {
            "role": "visitor",
            "request": {
              "page": "m_cp_avatar.php?KeepThis=true&TB_iframe=true&height=400&width=500",
              "method": "GET",
              "replace_params": true,
              "params": {
                "KeepThis": "true",
                "TB_iframe": "true",
                "height": "400",
                "width": "500"
              },
              "referer": "member_cp.php"
            },
            "assert": {
              "response_not_contains": "name=\"avatar\""
            }
          },
          "authorized": {
            "role": "user1",
            "request": {
              "page": "m_cp_avatar.php?KeepThis=true&TB_iframe=true&height=400&width=500",
              "method": "GET",
              "replace_params": true,
