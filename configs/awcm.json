            }
          }
        },
        {
          "name": "AWCM-GT-002-admin-profile-read",
          "page_pattern": "^member\\.php\\?id(?:=|&|$)",
          "category": "vertical",
          "operation": "read",
          "variables": {
            "admin_id": {
              "query": "SELECT id FROM awcm_members WHERE email='admin@qq.com' LIMIT 1"
            }
          },
          "setup_sql": [
            "UPDATE awcm_members SET title='{token}' WHERE id={admin_id}"
          ],
          "attack": {
            "role": "user1",
            "request": {
              "page": "member.php?id={admin_id}",
              "method": "GET",
              "replace_params": true,
              "params": {
                "id": "{admin_id}"
              },
              "referer": "online.php"
            },
            "assert": {
              "response_not_contains": "{token}"
            }
          },
          "authorized": {
            "role": "admin",
            "request": {
              "page": "member.php?id={admin_id}",
              "method": "GET",
              "replace_params": true,
              "params": {
                "id": "{admin_id}"
              },
              "referer": "online.php"
            },
