      "id": "3",
      "author": "3",
      "sender": "3",
      "reciever": "3",
      "memid": "3"
    },
    "oracle": {
      "timeout": 10,
      "csrf_token_parameters": [],
      "denied_statuses": [
        401,
        403
      ],
      "login_url_markers": [
        "login.php",
        "control/login.php"
      ],
      "deny_markers": [
        "login failed",
        "incorrect",
        "no permission",
        "not allowed",
        "access denied"
      ],
      "extract_source_deny_markers": true,
      "static_only_confirm_patterns": [
        "^install/index\\.php$",
        "^control/db_backup\\.php$"
      ],
      "confirm_get_read_patterns": [
        "^m_cp_avatar\\.php",
        "^member\\.php"
      ],
      "authenticated_public_page_patterns": [
