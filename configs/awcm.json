        "login",
        "signin",
        "warning",
        "warn",
        "error",
        "denied",
        "forbidden",
        "nopermission",
        "index.php"
      ]
    },
    "static_exclude_patterns": [
      "^install/(?!index\\.php$)",
      "^blocks/",
      "(^|/)logout\\.php$"
    ],
    "force_static_pages": [
      "install/index.php",
      "control/db_backup.php"
    ],
    "force_horizontal_pages": [
      "member.php",
      "member.php?id=p1"
