      },
      {
        "pattern": "^categories/\\d+/topics/\\d+/comments/\\d+/edit/?$",
        "replacement": "categories/p1/topics/p1/comments/p1/edit/"
      },
      {
        "pattern": "^categories/\\d+/topics/new/?$",
        "replacement": "categories/p1/topics/new/"
      },
      {
        "pattern": "^users/\\d+/?$",
        "replacement": "users/p1/"
      }
