        "key": "orangeforum_comment_new"
      },
      {
        "pattern": "^categories/(?:\\d+|p1)/topics/(?:\\d+|p1)/comments/(?:\\d+|p1)/edit/?$",
        "key": "orangeforum_comment_edit"
      },
      {
        "pattern": "^users/(?:\\d+|p1)/?$",
