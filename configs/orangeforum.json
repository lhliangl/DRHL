      ],
      "regression_roles": [
        {
          "pattern": "^categories/1/topics/9/comments/34/edit/?$",
          "role": "user2"
        }
      ]
    },
    "source_map_overrides": [
      {
        "pattern": "^admin/?$",
        "source": "views/admin.go"
      },
      {
        "pattern": "^auth/(?:signin|signup|otsignin|changepass)(?:\\?|$)",
        "source": "views/auth.go"
      },
      {
        "pattern": "^users/p1/?$",
        "source": "views/users.go"
      },
      {
        "pattern": "^categories/p1/?$",
