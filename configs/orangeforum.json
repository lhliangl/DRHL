    "deduplicate_url_patterns": [
      {
        "pattern": "^admin/categories/(?:\\d+|p1)/?$",
        "key": "orangeforum_admin_category"
      },
      {
        "pattern": "^categories/(?:\\d+|p1)/?$",
        "key": "orangeforum_category"
      },
      {
        "pattern": "^categories/(?:\\d+|p1)/topics/(?:\\d+|p1)/?$",
        "key": "orangeforum_topic"
      },
      {
        "pattern": "^categories/(?:\\d+|p1)/topics/(?:\\d+|p1)/edit/?$",
        "key": "orangeforum_topic_edit"
      },
      {
