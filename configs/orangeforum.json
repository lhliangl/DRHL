  "repair": {
    "enabled": true,
    "output_dir": "repair/files",
    "llm": {
      "enabled": true,
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "api_key": "your-api-key",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "syntax_timeout": 120,
      "temporary_apply_to_source": true,
      "go_binary": "go",
      "gofmt_binary": "gofmt",
      "hook_timeout": 120,
      "reload_timeout": 120,
      "after_apply_command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "D:/project/python/DRHL/scripts/orangeforum_restart.ps1",
        "-SourceRoot",
        "D:/Go_project/orangeforum",
        "-Port",
        "9123",
        "-Dsn",
        "postgres://postgres:root@localhost:5432/orangeforum"
      ],
      "after_restore_command": [
