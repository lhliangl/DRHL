              "name": "orangeforum_signin",
              "url": "auth/signin",
              "method": "FORM",
              "fields": {
                "input[name='email']": "user2@qq.com",
                "input[name='password']": "12345678"
              },
              "submit": "input[type='submit']",
              "wait_after": 1,
