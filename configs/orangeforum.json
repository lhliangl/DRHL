{
  "run_dir": "../runs/orangeforum",
  "target": {
    "base_url": "http://localhost:9123/forums/localhost/",
    "source_root": "D:/Go_project/orangeforum",
    "language": "go",
    "public_extensions": []
  },
  "database": {
    "driver": "postgresql",
    "host": "localhost",
    "port": 5432,
    "database": "orangeforum",
    "user": "postgres",
    "password": "root",
    "pg_dump": "D:/PostgreSQL/14/bin/pg_dump.exe",
    "psql": "D:/PostgreSQL/14/bin/psql.exe",
    "timeout": 180,
    "dump_extra_args": [],
    "restore_extra_args": []
