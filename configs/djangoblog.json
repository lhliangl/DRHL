    "base_url": "http://localhost:8000/",
    "source_root": "D:/project/python/DjangoBlog",
    "language": "python",
    "public_extensions": []
  },
  "database": {
    "driver": "sqlite",
    "path": "D:/project/python/DjangoBlog/db.sqlite3",
    "before_restore_command": [
      "D:/Anaconda3/envs/drhl/python.exe",
      "D:/project/python/DRHL/database_recovery/djangoblog_server_control.py",
      "stop",
      "--port",
      "8000"
    ],
    "after_restore_command": [
      "D:/Anaconda3/envs/drhl/python.exe",
      "D:/project/python/DRHL/database_recovery/djangoblog_server_control.py",
      "start",
      "--app-root",
      "D:/project/python/DjangoBlog",
      "--python",
      "D:/Anaconda3/envs/django/python.exe",
      "--host",
      "localhost",
      "--port",
      "8000",
      "--wait",
      "25"
    ]
  },
  "crawl": {
    "mode": "selenium",
    "driver_path": "../chromedriver.exe",
    "root_url": "",
    "scope_path": "/",
    "strategy": "dfs",
    "headless": true,
    "max_pages": 250,
    "delay": 0.2,
    "page_timeout": 20,
    "exclude_url_markers": [
      "logout",
      "/static/",
      "__debug__",
      "favicon.ico"
    ],
    "exclude_form_markers": [
      "logout",
      "admin/auth/",
      "admin/blog/",
      "admin/password_change/"
    ],
    "secret_parameters": [
      "password",
      "password1",
      "password2",
      "old_password",
      "new_password1",
      "new_password2",
      "csrfmiddlewaretoken",
      "csrf",
      "token"
    ],
    "skip_source_dirs": [
      ".git",
      ".idea",
      "__pycache__",
      ".pytest_cache",
      "venv",
      ".venv",
      "env",
      "migrations",
      "db_backup"
    ],
    "preserve_query_parameters": [
      "next"
    ],
    "drop_query_parameters": [
      "o",
      "p",
      "q",
      "all",
      "e",
      "is_popup",
      "_to_field",
      "_popup",
      "_changelist_filters",
      "is_staff__exact",
      "is_superuser__exact",
      "is_active__exact",
      "groups__id__exact",
      "groups__isnull",
      "status__exact"
    ],
    "redact_secret_parameters": false,
    "execute_forms": true,
    "execute_forms_limit_per_page": 20,
    "execute_forms_wait_after": 0.2,
    "form_values": {
