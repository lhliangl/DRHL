    "deduplicate_url_patterns": [
      {
        "pattern": "^admin/auth/user/[0-9]+/change/?(?:\\?|$)",
        "key": "admin/auth/user/{id}/change/"
      },
      {
        "pattern": "^admin/auth/user/[0-9]+/delete/?(?:\\?|$)",
        "key": "admin/auth/user/{id}/delete/"
      },
      {
        "pattern": "^admin/auth/user/[0-9]+/history/?(?:\\?|$)",
        "key": "admin/auth/user/{id}/history/"
      },
      {
        "pattern": "^admin/auth/user/[0-9]+/password/?(?:\\?|$)",
        "key": "admin/auth/user/{id}/password/"
      },
      {
        "pattern": "^admin/auth/group/[0-9]+/(?:change|delete|history)/?(?:\\?|$)",
        "key": "admin/auth/group/{id}/{action}/"
      },
      {
        "pattern": "^admin/blog/post/[0-9]+/(?:change|delete|history)/?(?:\\?|$)",
        "key": "admin/blog/post/{id}/{action}/"
      },
      {
        "pattern": "^(?!admin(?:/|$)|$|\\./)[^/?#]+/?$",
        "key": "blog/post/{slug}/"
      },
      {
        "pattern": "^admin/.+/[0-9]+/(?:change|delete|history|password)/?(?:\\?|$)",
        "key": "admin/{model}/{id}/{action}/"
      }
    ],
    "path_parameter_patterns": [
      {
        "pattern": "^(?!admin(?:/|$)|accounts(?:/|$)|static(?:/|$)|media(?:/|$)|$|\\./)[^/?#]+/?$",
        "replacement": "p1/"
      },
      {
        "pattern": "(^|/)\\d+(?=/|$)",
        "replacement": "\\1p1"
      }
    ]
  },
  "analysis": {
    "active_detection": true,
    "identity_parameters": [
      "id",
      "pk",
      "user_id",
      "author_id",
      "author",
      "username",
      "slug",
      "status"
    ],
    "horizontal_overrides": {
      "id": "4",
      "pk": "4",
      "user_id": "4",
      "author_id": "4",
      "author": "user2",
      "username": "user2",
      "slug": "eee",
      "status": "0"
    },
    "horizontal_exclude_patterns": [
      "^$",
      "^\\./$",
      "^admin/login/"
    ],
    "source_analysis": {
      "save_cst": false,
      "framework": "django",
      "identity_parameters": [
        "user_id",
        "author_id",
        "author",
        "username"
      ],
      "access_control_database_fields": [
        "is_staff",
        "is_superuser",
        "is_active",
        "groups",
        "author_id",
        "user_id",
        "status"
      ],
      "declarative_access_control_fields": [
        "Post.status"
      ],
      "validated_function_name_patterns": [
        "login_required",
        "permission_required",
        "user_passes_test",
        "staff_member_required",
        "get_object",
        "dispatch",
        "has_perm",
        "is_staff",
        "is_superuser",
        "is_authenticated"
      ],
      "validated_function_code_patterns": [
        "request\\.user",
        "is_staff",
        "is_superuser",
        "is_authenticated",
        "has_perm",
        "PermissionDenied",
        "Http404",
        "HttpResponseForbidden",
        "status\\s*==\\s*0"
      ]
    },
    "oracle": {
      "timeout": 10,
      "csrf_token_parameters": [
        "csrfmiddlewaretoken"
      ],
      "denied_statuses": [
        401,
        403,
        404
      ],
      "login_url_markers": [
        "/admin/login",
        "login"
      ],
      "deny_markers": [
        "Please enter the correct username and password",
        "Log in",
        "Authentication and Authorization",
        "You don't have permission",
        "Page not found",
        "Not Found"
      ],
      "extract_source_deny_markers": true,
      "invalid_resource_markers": [
        "Page not found",
        "Not Found"
      ],
      "public_page_patterns": [
        "^$",
        "^\\./$",
        "^admin/login/",
        "^p1/$"
      ],
      "authenticated_public_page_patterns": [
        "^admin/logout/",
        "^admin/password_change/"
      ],
      "confirm_get_read_patterns": [
        "^$",
        "^\\./$"
      ],
      "write_success_redirect_is_vulnerable": true,
      "authorized_success_redirect_patterns": [
        "^admin/",
        "^[^/?#]+/$"
      ],
      "write_success_redirect_patterns": [
        "^admin/",
        "^[^/?#]+/$"
      ],
      "protected_content_markers": [
        {
          "pattern": "^([^/?#]+)/$",
          "marker_group": 1
        }
      ]
    },
    "static_exclude_patterns": [
      "^manage\\.py$",
      "^mysite/settings\\.py$",
      "^.*?/migrations/.*$"
    ]
  },
  "repair": {
    "enabled": true,
    "output_dir": "repair/files",
    "llm": {
      "enabled": true,
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "api_key": "env:DRHL_DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "syntax_timeout": 30,
      "temporary_apply_to_source": true,
      "python_binary": "D:/Anaconda3/envs/drhl/python.exe",
      "reload_command": [
        "D:/Anaconda3/envs/drhl/python.exe",
        "D:/project/python/DRHL/database_recovery/djangoblog_server_control.py",
        "restart",
        "--app-root",
        "D:/project/python/DjangoBlog",
        "--python",
        "D:/Anaconda3/envs/django/python.exe",
        "--host",
        "localhost",
        "--port",
        "8000",
        "--wait",
        "25"
      ],
      "database_oracles": {
        "response_only_patterns": [
          ".*"
        ],
        "rules": []
      }
    },
    "source_map_overrides": [
      {
        "pattern": "^p1/$",
        "source": "blog/views.py"
      },
      {
        "pattern": "^$",
        "source": "blog/views.py"
      },
      {
        "pattern": "^\\./$",
