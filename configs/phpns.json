  "repair": {
    "enabled": true,
    "output_dir": "repair/files",
    "llm": {
      "enabled": true,
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "api_key": "your-api-key",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "php_binary": "D:/phpStudy/PHPTutorial/php/php-5.2.17/php.exe",
      "syntax_timeout": 30,
      "temporary_apply_to_source": true
    },
    "user_table_context": {
      "enabled": true,
      "table": "phpns_users",
      "columns": [
        "id",
        "user_name",
        "rank_id"
      ],
      "order_by": "id",
      "limit": 20,
      "role_column": "rank_id",
      "sample_by_role_when_rows_gte": 5,
      "max_rows_per_role": 2,
      "scan_limit": 1000
    },
    "identity_context": {
      "enabled": true,
      "current_user": [
        {
          "name": "current_username",
          "expression": "$_SESSION['username']",
          "source": "inc/auth.php",
          "description": "Current logged-in username set after cookie/session authentication."
        },
        {
          "name": "current_user_id",
          "expression": "$_SESSION['userID']",
          "source": "inc/auth.php",
          "description": "Current logged-in user id set after cookie/session authentication."
        },
        {
          "name": "current_permissions",
          "expression": "$globalvars['rank']",
          "source": "inc/auth.php",
          "description": "Permission string copied from $_SESSION[permissions]; individual offsets are used as guards."
        }
      ],
      "bindings": [
        {
          "source_path": "article.php",
          "parameter": "id",
          "table": "phpns_articles",
          "lookup_column": "id",
          "owner_column": "article_author",
          "current_user_expression": "$_SESSION['username']",
          "privileged_bypass": "admin user: $_SESSION['username'] == 'admin' or current phpns_users.rank_id == 1",
          "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
          "sample_columns": [
            "id",
            "article_author",
            "article_title"
          ],
          "description": "Article edit pages must compare requested article id to phpns_articles.article_author; allow the owner or the administrator only.",
          "page_pattern": "(?:^|/)article\\.php\\?do=edit(?:&|$)"
        },
        {
          "source_path": "user.php",
          "parameter": "id",
          "table": "phpns_users",
          "lookup_column": "id",
          "owner_column": "id",
          "current_user_expression": "$_SESSION['userID']",
          "privileged_bypass": "admin user: $_SESSION['username'] == 'admin' or current phpns_users.rank_id == 1",
          "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
          "sample_columns": [
            "id",
            "user_name",
            "rank_id"
          ],
          "description": "User edit pages must compare requested user id with the current session user id; allow the same user or the administrator only.",
          "page_pattern": "(?:^|/)user\\.php\\?do=edit(?:&|$)"
        }
      ]
    },
    "page_repair_guidance": [
      {
        "page_pattern": "(?:^|/)install/index\\.php$",
        "category": "static_only",
        "intended_fix": "Require an authenticated phpns user before allowing the installer entry page to continue.",
        "allowed_condition": "user is logged in according to phpns existing auth/session semantics",
        "deny_action": "Use the existing phpns redirect/denial style and exit immediately.",
        "notes": [
          "Do not disable the installer by returning a blank page.",
          "Do not invent new session keys; reuse the session/auth variables initialized by the included project files."
        ]
      },
      {
        "page_pattern": "(?:^|/)article\\.php\\?action=delete&do=comments(?:&|$)",
        "category": "vertical",
        "intended_fix": "Deleting comments is a vertical privilege check, not an ownership check.",
        "allowed_condition": "allow only if the current user has the existing edit-article permission OR the current user's phpns_users.rank_id is the users rank_id (rank_id=3); block register rank_id=2.",
        "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
        "notes": [
          "The attacking role is register, which can log in but must not delete comments.",
          "Prefer existing $globalvars['rank'] permission semantics for edit-article permission when available.",
          "If checking rank_id, query phpns_users using $_SESSION['userID']; users rank_id is 3 and register rank_id is 2 in database_user_table_context."
        ]
      },
      {
        "page_pattern": "(?:^|/)article\\.php\\?do=comments(?:&|$)",
        "category": "vertical",
        "intended_fix": "Viewing/managing article comments is a vertical privilege check, not a horizontal owner check.",
        "allowed_condition": "allow only if the current user has the existing edit-article permission OR the current user's phpns_users.rank_id is the users rank_id (rank_id=3); block register rank_id=2.",
        "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
        "notes": [
          "Do not compare article_author for this repair item.",
          "The vulnerability is that register can access the comments management page despite only having login privilege.",
          "If checking rank_id, query phpns_users using $_SESSION['userID']; users rank_id is 3 and register rank_id is 2 in database_user_table_context."
        ]
      },
      {
        "page_pattern": "(?:^|/)article\\.php\\?do=edit(?:&|$)",
        "category": "horizontal",
        "intended_fix": "Article edit is a horizontal owner check with an admin bypass.",
        "allowed_condition": "allow if phpns_articles.article_author equals $_SESSION['username'] OR the current user is administrator (admin username or rank_id=1).",
        "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
        "notes": [
          "Do not use $globalvars['rank'][14] as a broad bypass here because users may have edit permission; the required bypass is administrator only.",
          "Use the identity_binding_context owner column phpns_articles.article_author."
        ]
      },
      {
        "page_pattern": "(?:^|/)user\\.php\\?do=edit(?:&|$)",
        "category": "horizontal",
        "intended_fix": "User edit is a horizontal self-check with an admin bypass.",
        "allowed_condition": "allow if requested phpns_users.id equals $_SESSION['userID'] OR the current user is administrator (admin username or rank_id=1).",
        "deny_action": "header(\"Location: index.php?do=permissiondenied\"); die();",
        "notes": [
          "Do not use $globalvars['rank'][2] as a broad bypass here; the required bypass is administrator only.",
          "Use the identity_binding_context owner column phpns_users.id and current_user_expression $_SESSION['userID']."
        ]
      }
    ]
  }
}

