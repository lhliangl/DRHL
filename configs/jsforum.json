              "method": "POST",
              "data": {
                "username": "admin",
                "password": "123456"
              },
              "wait_after": 1,
              "expect_cookies": [
                "JSESSIONID"
              ],
              "forbid_text": [
                "wrongpass",
                "The password doesn't match"
              ],
              "seed_urls": [
                "forum/index.jsp",
                "forum/index.jsp?page=profile",
