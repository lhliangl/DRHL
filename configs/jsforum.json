                "title": "{token}",
                "forum_info": "DRHL repair oracle unauthorized forum"
              },
              "referer": "forum/index.jsp"
            },
            "assert": {
              "query": "SELECT COUNT(*) FROM forum_forums WHERE title='{token}'",
              "scalar_zero": true
            }
          },
          "authorized": {
