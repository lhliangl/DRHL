      "pw",
      "passwd",
      "pwd",
      "token",
      "csrf",
      "_token"
    ],
    "skip_source_dirs": [
      ".clover",
      "coverage-report",
      "WEB-INF/classes/forum/instrumented"
    ],
    "preserve_query_parameters": [
      "page"
    ],
    "redact_secret_parameters": false,
    "execute_forms": true,
    "execute_forms_limit_per_page": 20,
