  "analysis": {
    "source_analysis": {
      "save_cst": false,
      "identity_parameters": [
        "user",
        "username",
        "user_name"
      ],
      "access_control_database_fields": [
        "forum_users.user_name",
        "forum_users.TYPE",
        "forum_users.type",
        "forum_message.user"
      ],
      "validated_function_name_patterns": [],
      "access_control_keywords": [
        "sessionUsername",
        "sessionType",
        "session.getAttribute",
        "getAttribute",
        "Admin",
        "username",
        "type",
        "password",
        "forum_users"
      ]
    },
    "active_detection": true,
    "identity_parameters": [
      "user",
      "username",
      "user_name"
    ],
    "horizontal_exclude_patterns": [
      "^forum/index\\.jsp(?:\\?|$)"
    ],
    "oracle": {
      "timeout": 10,
      "denied_statuses": [
        401,
        403
      ],
      "login_url_markers": [
        "forum/index.jsp"
      ],
      "deny_markers": [
        "You have to login first",
        "The password doesn't match",
        "wrongpass"
      ],
      "extract_source_deny_markers": true,
      "public_page_patterns": [
        "^forum/index\\.jsp(?:\\?|$)",
        "^forum/register\\.jsp(?:\\?|$)",
        "^forum/info\\.jsp(?:\\?|$)",
        "^servlet/forum\\.Login(?:\\?|$)",
        "^servlet/forum\\.AddUser(?:\\?|$)"
      ],
      "authenticated_public_page_patterns": [
        "^forum/index\\.jsp\\?page=profile(?:&|$)",
        "^servlet/forum\\.ChangeProfile(?:\\?|$)",
        "^forum/index\\.jsp\\?page=thread(?:&|$)",
        "^forum/index\\.jsp\\?page=message(?:&|$)",
        "^servlet/forum\\.AddThread(?:\\?|$)",
        "^servlet/forum\\.AddReply(?:\\?|$)"
      ],
      "confirm_get_read_patterns": [
        "^forum/index\\.jsp\\?page=(?:profile|thread|message|editmessage)(?:&|$)"
      ],
      "write_success_redirect_is_vulnerable": true,
      "authorized_success_redirect_patterns": [
        "^forum/index\\.jsp(?:\\?|$)"
      ],
      "write_success_redirect_patterns": [
        "^forum/index\\.jsp(?:\\?|$)",
        "^forum/index\\.jsp\\?page=thread(?:&|$)",
        "^forum/index\\.jsp\\?page=message(?:&|$)"
      ]
    },
    "attacker_roles": {
      "admin_only": [
        "user1",
        "user2",
        "visitor"
      ],
      "only_admin": [
        "user1",
        "user2",
        "visitor"
      ],
      "static_only": [
        "visitor"
      ],
      "authenticated_only": [
        "visitor"
      ],
      "horizontal": [
        "user1",
        "user2"
      ]
    },
    "static_exclude_patterns": [
      "(^|/)WEB-INF/",
      "(^|/)META-INF/",
      "(^|/)CVS/",
      "(^|/)\\.clover/",
      "(^|/)forum/include/",
      "\\.drhlbak$",
      "\\.class$",
      "\\.java$",
      "^forum/index\\.jsp$",
      "^forum/info\\.jsp$",
      "^forum/register\\.jsp$"
    ],
    "horizontal_overrides": {
      "user": "user2"
    }
  },
  "repair": {
    "enabled": true,
    "output_dir": "repair/files",
    "llm": {
      "enabled": true,
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "api_key": "your-api-key",
      "temperature": 0.1,
      "timeout": 120,
      "response_format_json": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0
    },
    "validation": {
      "max_attempts": 3,
      "syntax_check": true,
      "syntax_timeout": 30,
      "temporary_apply_to_source": true,
      "javac": "javac",
      "classes_dir": "WEB-INF/classes",
      "tomcat_home": "D:/tomcat9",
      "reload_strategy": "touch_web_xml",
      "reload_wait": 8.0
    }
  }
