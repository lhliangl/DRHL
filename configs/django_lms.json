        "key": "quiz/{slug}/{action}/"
      },
      {
        "pattern": "^quiz/[0-9]+/[^/]+/take/?(?:\\?|$)",
        "key": "quiz/{id}/{slug}/take/"
      },
      {
        "pattern": "^result/result/print/[0-9]+/?(?:\\?|$)",
        "key": "result/result/print/{id}/"
      },
      {
        "pattern": "(^|/)\\d+(?=/|$)",
        "key": "path/{id}/"
      },
      {
        "pattern": "^programs/course/[^/]+/",
        "key": "programs/course/{slug}/"
      },
      {
        "pattern": "^quiz/[^/]+/",
        "key": "quiz/{slug}/"
