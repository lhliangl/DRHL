        "^login\\.php(?:\\?|$)",
        "^user_new\\.php(?:\\?|$)",
        "^info\\.php(?:\\?|$)",
        "^training\\.php(?:\\?|$)",
        "^captcha(?:_box)?\\.php(?:\\?|$)",
        "^security_level_set\\.php(?:\\?|$)",
        "^training_install\\.php(?:\\?|$)"
      ],
      "authenticated_public_page_patterns": [
        "^portal\\.php(?:\\?|$)",
        "^security_level_set\\.php(?:\\?|$)",
        "^credits\\.php(?:\\?|$)"
      ]
    },
    "static_exclude_patterns": [
      "^soap/",
      "^lang_[a-z]+\\.php$",
      "^(?:config\\.inc|connect|connect_i|functions_external|security|security_level_check|selections)\\.php$",
      "^admin/settings\\.php$",
      "(^|/)index[^/]*\\.php(?:\\?|$)",
      "(^|/)[^/]*info[^/]*\\.php(?:\\?|$)",
      "^training_install\\.php(?:\\?|$)"
