{
  "run_dir": "../runs/bwapp",
  "target": {
    "base_url": "http://localhost/bWAPP/",
    "source_root": "D:/phpStudy/PHPTutorial/WWW/bWAPP",
    "language": "php",
    "public_extensions": [
      ".php"
    ]
  },
  "database": {
    "driver": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "bwapp",
