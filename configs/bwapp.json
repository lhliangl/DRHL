  "crawl": {
    "mode": "selenium",
    "driver_path": "../chromedriver.exe",
    "root_url": "index.php",
    "scope_path": "/bWAPP/",
    "strategy": "dfs",
    "headless": true,
    "max_pages": 300,
    "delay": 0.2,
    "page_timeout": 20,
    "exclude_url_markers": [
      "logout",
      "logoff",
      "ba_logout"
    ],
    "secret_parameters": [
      "password",
      "pw",
      "passwd",
      "pwd",
      "token",
      "csrf",
      "_token"
    ],
    "skip_source_dirs": [
      "admin/db",
      "db",
      "documents",
      "images",
      "js",
      "logs",
      "passwords",
      "soap",
      "stylesheets"
    ],
    "preserve_query_parameters": [
      "bug",
      "install",
      "security_level",
      "form",
      "login",
      "id",
      "title",
      "movie"
    ],
    "redact_secret_parameters": false,
    "execute_forms": true,
    "execute_forms_limit_per_page": 20,
    "execute_forms_wait_after": 0.2,
    "roles": [
      {
        "name": "admin",
        "kind": "admin",
        "crawl_login": {
          "steps": [
            {
              "name": "bee_login",
              "url": "login.php",
              "post_url": "login.php",
              "method": "POST",
              "data": {
                "login": "bee",
                "password": "bug",
                "security_level": "0",
                "form": "submit"
              },
              "wait_after": 1,
              "expect_cookies": [
                "PHPSESSID",
                "security_level"
              ],
              "forbid_text": [
                "Invalid credentials",
                "user not activated"
              ],
              "seed_urls": [
                "portal.php",
                "security_level_set.php",
                "password_change.php",
                "user_extra.php",
                "reset.php",
                "credits.php",
                "admin/index.php",
                "admin/phpinfo.php",
                "admin/settings.php"
              ]
            }
          ]
        },
        "http_login": {
          "steps": [
            {
              "name": "bee_login",
              "url": "login.php",
              "post_url": "login.php",
              "method": "POST",
              "data": {
                "login": "bee",
                "password": "bug",
                "security_level": "0",
                "form": "submit"
              },
              "expect_cookies": [
                "PHPSESSID",
                "security_level"
              ],
              "forbid_text": [
                "Invalid credentials",
                "user not activated"
              ]
            }
          ]
        }
      },
      {
        "name": "visitor",
        "kind": "visitor"
      }
    ],
    "drop_query_parameters": [
      "PHPSESSID"
    ]
  },
  "analysis": {
    "source_analysis": {
      "save_cst": false,
      "identity_parameters": [
        "login",
        "user",
        "uid",
        "owner"
      ],
      "access_control_database_fields": [
        "users.login",
        "users.admin",
        "users.activated",
        "blog.owner"
      ],
      "validated_function_name_patterns": [
        "security",
        "login",
        "session",
        "check"
      ],
      "validated_function_code_patterns": [
        "\\$_SESSION\\[\\s*['\\\"]login['\\\"]\\s*\\]",
        "\\$_SESSION\\[\\s*['\\\"]admin['\\\"]\\s*\\]",
        "header\\s*\\(\\s*['\\\"]Location:\\s*login\\.php",
        "\\$_COOKIE\\[\\s*['\\\"]security_level['\\\"]\\s*\\]"
      ]
    },
    "active_detection": true,
    "identity_parameters": [
      "id",
      "login",
      "user",
      "uid",
      "owner",
      "movie",
      "title"
    ],
    "horizontal_overrides": {
      "id": "1",
      "login": "A.I.M.",
      "user": "A.I.M.",
      "uid": "1",
      "owner": "A.I.M."
    },
    "oracle": {
      "timeout": 10,
      "denied_statuses": [
        401,
        403
      ],
      "login_url_markers": [
        "login.php"
      ],
      "deny_markers": [
        "Invalid credentials",
        "user not activated",
        "Login:",
        "Password:",
        "Enter your credentials",
        "You are not welcome here",
        "don't have a valid session",
        "You do not have a valid session"
